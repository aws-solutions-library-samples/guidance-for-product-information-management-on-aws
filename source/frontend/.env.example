# API Gateway Endpoint
# Get this from CDK output: EtlTriggerEndpoint
REACT_APP_API_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/development

# Cognito Configuration (if not already configured)
REACT_APP_USER_POOL_ID=your-user-pool-id
REACT_APP_USER_POOL_CLIENT_ID=your-client-id
REACT_APP_REGION=us-east-1
